# Connexion PostgreSQL (Neon : Dashboard > Connect).
# URL « pooled » (avec -pooler dans l'hôte) pour l'application :
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# URL directe (sans -pooler) pour les migrations. Facultatif : DATABASE_URL est utilisée sinon.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Secret de signature des sessions : valeur longue et aléatoire, générée par exemple avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-with-a-long-random-string"

# Super admin créé au premier déploiement (ou par `npm run db:seed`) s'il n'existe pas
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choisissez-un-mot-de-passe-solide"
# true le temps d'UN déploiement pour remplacer le mot de passe d'un admin existant par ADMIN_PASSWORD
# ADMIN_RESET_PASSWORD="true"

# true derrière HTTPS (Vercel)
COOKIE_SECURE="true"
